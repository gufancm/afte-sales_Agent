    {
      "rule_id": "R-JD-NR-DENY-FRESH-001",
      "version": "2026.10-jd",
      "priority": 130,
      "when": [
        {
          "fact": "claim.reason_code",
          "op": "in",
          "value": [
            "NO_LONGER_NEEDED",
            "SIZE_ISSUE",
            "COLOR_MISMATCH"
          ]
        },
        {
          "fact": "order.category",
          "op": "eq",
          "value": "FRESH"
        },
        {
          "fact": "order.status",
          "op": "eq",
          "value": "DELIVERED"
