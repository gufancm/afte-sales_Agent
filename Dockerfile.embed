# Dockerfile.embed — 本地 BGE-M3 向量服务（OpenAI 兼容 /v1/embeddings）
# 模型权重不打进镜像：由 docker-compose 以只读卷挂载宿主机目录（BGE_M3_HOST_DIR），
# 容器内 HF_HUB_OFFLINE=1，运行期不访问外网，满足内网/合规部署。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false

# CPU 版 torch（体积可控、无需 GPU 运行时）。如要用 GPU：改用 nvidia/cuda 基础镜像
# 并安装 cu12x 轮子，同时把 compose 的 embed.command 里 --device 改为 cuda、--dtype 改为 float16。
# 基础依赖源：国内走清华 PyPI 镜像；如需官方 PyPI 覆盖 --build-arg PIP_INDEX=https://pypi.org/simple
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

# 必须把 TORCH_INDEX 作为主源、PIP_INDEX 作为附加源：
# torch 的 +cpu 轮子（版本号带 local segment，优先级高于 PyPI 的 CUDA 版）只存在于 TORCH_INDEX，
# 而 filelock/sympy 等依赖只在 PIP_INDEX。反过来写会拉到几百 MB 的 CUDA 版 torch。
RUN pip install --no-cache-dir --index-url ${TORCH_INDEX} --extra-index-url ${PIP_INDEX} torch \
 && pip install --no-cache-dir --index-url ${PIP_INDEX} transformers fastapi uvicorn sentencepiece protobuf

WORKDIR /app
COPY scripts/serve_embedding.py scripts/serve_reranker.py /app/scripts/

EXPOSE 7997
CMD ["python", "scripts/serve_embedding.py", "--model-path", "/models/bge-m3", "--host", "0.0.0.0", "--port", "7997"]