# 与 .env 相同，仅作示例（docker compose 默认读取 .env）
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://aftersale_app:app_pw_change_me@postgres:5432/aftersale
WORKER_DATABASE_URL=postgresql+asyncpg://aftersale_worker:worker_pw_change_me@postgres:5432/aftersale
REDIS_URL=redis://redis:6379/0
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=<YOUR_MODEL>
# 端点私有参数透传（JSON 对象）。阿里百炼上关掉 DeepSeek 思考模式：{"enable_thinking": false}
LLM_EXTRA_BODY=
LLM_INTENT_CONFIDENCE_THRESHOLD=0.6
LLM_INTENT_FASTPATH_ENABLED=true
LLM_INTENT_SMALL_MODEL_ENABLED=true
LLM_INTENT_COMPLEXITY_THRESHOLD=2
LLM_MODEL_SMALL=
LLM_SMALL_BASE_URL=
LLM_SMALL_API_KEY=
LLM_SMALL_MAX_OUTPUT_TOKENS=0
LLM_SMALL_CONTEXT_WINDOW=0
EMBEDDING_BASE_URL=http://embed:7997/v1
EMBEDDING_API_KEY=local-dev-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
BGE_M3_HOST_DIR=E:/agent/models/bge-m3
RAG_BACKEND=pg
OMS_MCP_URL=http://mcp-mock:9100
TMS_MCP_URL=http://mcp-mock:9100
FINANCE_MCP_URL=http://mcp-mock:9100
FINANCE_REAL_WRITES_ENABLED=false
# 只读自助答复：事实用模板、措辞用 LLM（带后置校验，失败回退纯模板）
READONLY_LLM_REPHRASE_ENABLED=true

# ---- ActionPlanner：确定性快路径 + 计划审查 + 有界重规划 ----
PLANNER_FASTPATH_ENABLED=true
PLANNER_LLM_CRITIC_ENABLED=false
PLANNER_MAX_REPLANS=1

# ---- 检索增强：真实 BM25 / BGE Reranker / 查询变换（多查询+HyDE）----
RAG_BM25_K1=1.2
RAG_BM25_B=0.75
RAG_TOKENIZER=jieba
RAG_RERANK_ENABLED=true
RERANK_BASE_URL=http://rerank:7998
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=local-dev-key
RERANK_TIMEOUT_MS=10000
# 查询变换：off / always / adaptive（生产默认 adaptive）
RAG_TRANSFORM_POLICY=adaptive
RAG_QUERY_REWRITE_ENABLED=true
RAG_MULTI_QUERY_N=3
RAG_HYDE_ENABLED=true
# adaptive 门控：硬信号单条即触发；软信号需同时满足 SOFT_SIGNALS_REQUIRED 条
RAG_ADAPTIVE_MIN_DENSE_SIM=0.60
RAG_ADAPTIVE_MIN_MARGIN=0.015
RAG_ADAPTIVE_SHORT_QUERY_CHARS=8
RAG_ADAPTIVE_MIN_CANDIDATES=5
RAG_ADAPTIVE_SOFT_SIGNALS_REQUIRED=2
RAG_ADAPTIVE_CONTEXT_CHARS=240
RAG_ADAPTIVE_CONTEXT_MESSAGES=4
RAG_ADAPTIVE_USE_REQUIRED_COVERAGE=true
RAG_ADAPTIVE_MIN_REQUIRED_COVERAGE=0.5
RAG_TRANSFORM_CACHE_TTL_S=900
RAG_TRANSFORM_CACHE_MAX=512
RAG_TRANSFORM_TIMEOUT_MS=2500
RAG_TRANSFORM_DAILY_CALL_BUDGET=300
RAG_REQUIRE_EMBEDDINGS=true
RAG_ALLOW_LEXICAL_ONLY=false

# ---- 记忆系统（短期跨轮 / 情景 / 语义）----
# 短期跨轮：最近 N 轮逐字回放，更早内容折叠为滚动摘要（需 LLM；关闭则仅窗口截断）
MEMORY_RECENT_TURNS=8
MEMORY_MAX_TURNS=12
MEMORY_SUMMARY_TOKENS=1500
MEMORY_SUMMARY_ENABLED=true
# 情景记忆：终态工单归档为摘要 + 向量（BGE-M3），按用户/租户作用域召回
MEMORY_EPISODIC_ENABLED=true
MEMORY_EPISODIC_TOP_K=3
MEMORY_EPISODIC_MIN_SCORE=0.35
MEMORY_EPISODIC_LLM_SUMMARY=true
# 语义记忆：用户画像（非权威，可选）
MEMORY_SEMANTIC_ENABLED=true

# ---- LangGraph Checkpointer（HITL 暂停点持久化）----
# memory=进程内（测试）；postgres=跨重启/多副本可恢复（生产，docker compose 默认）
CHECKPOINT_BACKEND=postgres
CHECKPOINT_SETUP_ON_START=true
# CHECKPOINT_DATABASE_URL=   # 留空则由 DATABASE_URL 去掉 +asyncpg 派生
# true=Postgres 不可用即拒绝启动，避免「以为能恢复、其实不能」
CHECKPOINT_STRICT=false

# ---- 图节点级重试（仅瞬时故障；写节点永不重试）----
GRAPH_NODE_RETRY_ENABLED=true
GRAPH_NODE_RETRY_MAX_ATTEMPTS=3
GRAPH_NODE_RETRY_INITIAL_INTERVAL_S=0.2
GRAPH_NODE_RETRY_BACKOFF_FACTOR=2.0
GRAPH_NODE_RETRY_MAX_INTERVAL_S=3.0

# ---- MCP stdio Server（python -m app.mcp.stdio_server）----
# asgi=进程内直连 mock 处理器（默认，零网络）；http=转发到 MCP_MOCK_URL
MCP_STDIO_BACKEND=asgi
# MCP_MOCK_URL=http://localhost:9100
